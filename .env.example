APP_NAME=Inclinio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.inclinio.localhost

# Override del model d'usuari (per defecte App\Modules\Identity\Domain\Models\User).
# Útil només si en algun moment es vol substituir per un altre model en algun entorn.
# AUTH_MODEL=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Connecta amb el contenidor `mysql` definit a docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inclinio
DB_USERNAME=inclinio
DB_PASSWORD=inclinio

# Cache i sessions via Redis i cookies (necessari per a Sanctum SPA).
CACHE_STORE=redis
SESSION_DRIVER=cookie
SESSION_DOMAIN=.inclinio.localhost
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

# Mailpit captura tots els emails enviats en desenvolupament.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hola@inclinio.localhost
MAIL_FROM_NAME="${APP_NAME}"

# Domini autoritzat per a la SPA (panell admin) — Sanctum SPA auth amb cookies.
SANCTUM_STATEFUL_DOMAINS=admin.inclinio.localhost

# Credencials del primer usuari admin (usat pel seeder AdminSeeder).
# Canvieu-les abans del primer deploy.
ADMIN_EMAIL=admin@inclinio.localhost
ADMIN_PASSWORD=admin
